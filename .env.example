# --- LLM providers ---
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=

# --- Embeddings ---
GEMINI_API_KEY=
JINA_API_KEY=

# --- Qdrant vector store (cloud) ---
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=

# --- OpenAI LLM (guardrails + RAG generation via Portkey) ---
OPENAI_API_KEY=

# --- Portkey LLM gateway ---
PORTKEY_API_KEY=
PORTKEY_PRIMARY_SLUG=
PORTKEY_FALLBACK_SLUG=
PORTKEY_PRIMARY_CONFIG_ID=

# --- Persistence (Neon Postgres) & cache (Upstash Redis) ---
NEON_DB_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_USER_KEY=

# --- API safety ---
RAG_API_KEY=
RATE_LIMIT_PER_MINUTE=60

# --- Observability (optional) ---
LOGFIRE_TOKEN=
LOGFIRE_BASE_URL=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# --- Backend URL for Streamlit UI ---
BACKEND_URL=http://localhost:8000

# --- Judge LLM for RAGAS evals (falls back to OPENAI_API_KEY) ---
JUDGE_OPENAI_API_KEY=

# --- Conversational memory (mem0 Platform API) ---
MEM0_API_KEY=
MEMORY_ENABLED=true
MEMORY_COMPACTION_EVERY=5
